<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="250.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefWidth="267.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <ListView HBox.hgrow="ALWAYS" />
            <VBox minWidth="-Infinity" spacing="5.0" HBox.hgrow="NEVER">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Add" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Remove" />
                  <Separator />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Move Up" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Move Down" />
               </children>
            </VBox>
         </children>
      </HBox>
      <ButtonBar prefHeight="40.0" prefWidth="200.0">
        <buttons>
          <Button defaultButton="true" mnemonicParsing="false" text="OK" />
        </buttons>
      </ButtonBar>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
